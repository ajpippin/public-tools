ifndef ROOTDIR
    ROOTDIR =.
endif

ifndef BUILD_XML
    BUILD_XML =build.xml
endif



default:
	@(cd $(ROOTDIR) && ant -f $(BUILD_XML) compile )

%:
	@(cd $(ROOTDIR) && ant -f $(BUILD_XML) $@ )
